#!/usr/bin/env bash

##############################################################################
# Build and Push to ECR Script
# Builds Docker images and pushes to AWS ECR
##############################################################################

set -o pipefail

# Color codes for output
readonly COLOR_CYAN='\033[0;36m'
readonly COLOR_GREEN='\033[0;32m'
readonly COLOR_RED='\033[0;31m'
readonly COLOR_YELLOW='\033[1;33m'
readonly COLOR_NC='\033[0m'

# Global variables
DRY_RUN=false
AWS_ACCOUNT_ID=""
AWS_PROFILE="dp-ci"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
declare -a SELECTED_IMAGES=()
declare -A IMAGE_PATHS=()

##############################################################################
# Utility Functions
##############################################################################

log_info() {
    echo -e "${COLOR_CYAN}ℹ ${1}${COLOR_NC}"
}

log_success() {
    echo -e "${COLOR_GREEN}✓ ${1}${COLOR_NC}"
}

log_error() {
    echo -e "${COLOR_RED}✗ ${1}${COLOR_NC}"
}

log_warning() {
    echo -e "${COLOR_YELLOW}⚠ ${1}${COLOR_NC}"
}

##############################################################################
# Dependency Checking
##############################################################################

check_dependencies() {
    local deps=("yq" "docker" "aws" "git")
    local missing=()
    
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            missing+=("$dep")
        fi
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing required tools: ${missing[*]}"
        log_info "Please install the missing dependencies and try again."
        exit 1
    fi
    
    log_success "All required dependencies are installed"
}

##############################################################################
# Discovery
##############################################################################

discover_images() {
    log_info "Discovering Docker images..."
    
    local count=0
    while IFS= read -r config_file; do
        local image_dir=$(dirname "$config_file")
        local image_name="${image_dir#$REPO_ROOT/}"
        local component_count=$(yq eval '.components | length' "$config_file" 2>/dev/null)
        if [[ "$component_count" -gt 0 ]]; then
            IMAGE_PATHS[$image_name]="$image_dir"
            ((count++))
        fi
    done < <(find "$REPO_ROOT" -name "tag-config.yaml" -type f | sort)
    
    if [[ $count -eq 0 ]]; then
        log_error "No tag-config.yaml files with components found!"
        exit 1
    fi
    
    log_success "Discovered $count Docker image(s)"
}

##############################################################################
# Component Detection
##############################################################################

has_golang_component() {
    local image=$1
    local config="${IMAGE_PATHS[$image]}/tag-config.yaml"
    yq eval '.components[] | select(.name == "golang")' "$config" 2>/dev/null | grep -q .
}

##############################################################################
# Interactive Menu
##############################################################################

show_menu() {
    log_info "\nAvailable Docker images:"
    echo ""
    
    local index=1
    local images_array=()
    
    for image in $(printf '%s\n' "${!IMAGE_PATHS[@]}" | sort); do
        images_array+=("$image")
        printf "  %2d) %-40s\n" "$index" "$image"
        ((index++))
    done
    
    # Check if there are Go-based images
    local has_go_images=false
    for image in "${images_array[@]}"; do
        if has_golang_component "$image"; then
            has_go_images=true
            break
        fi
    done
    
    echo ""
    echo "  Options:"
    echo "    Enter numbers (space, comma, or range: e.g., '1 3 5-7' or '1,3,5-7')"
    echo "    'A' = Select all images"
    if [[ "$has_go_images" == true ]]; then
        echo "    'G' = Select all Go-based images"
    fi
    echo "    'Q' = Quit"
    echo ""
    
    read -p "Select images: " -r selection
    
    case "${selection,,}" in
        a)
            SELECTED_IMAGES=("${images_array[@]}")
            ;;
        g)
            select_go_images "${images_array[@]}"
            if [[ ${#SELECTED_IMAGES[@]} -eq 0 ]]; then
                log_error "No Go-based images found"
                exit 1
            fi
            ;;
        q)
            log_info "Exiting..."
            exit 0
            ;;
        *)
            parse_selection "$selection" "${images_array[@]}"
            ;;
    esac
    
    if [[ ${#SELECTED_IMAGES[@]} -eq 0 ]]; then
        log_error "No images selected"
        exit 1
    fi
    
    log_success "Selected ${#SELECTED_IMAGES[@]} image(s) for build/push"
}

select_go_images() {
    local images_array=("$@")
    
    for image in "${images_array[@]}"; do
        if has_golang_component "$image"; then
            SELECTED_IMAGES+=("$image")
        fi
    done
}

parse_selection() {
    local selection=$1
    shift
    local images_array=("$@")
    
    selection="${selection//,/ }"
    
    for item in $selection; do
        if [[ $item =~ ^([0-9]+)-([0-9]+)$ ]]; then
            local start=${BASH_REMATCH[1]}
            local end=${BASH_REMATCH[2]}
            for num in $(seq "$start" "$end"); do
                if [[ $num -ge 1 && $num -le ${#images_array[@]} ]]; then
                    SELECTED_IMAGES+=("${images_array[$((num-1))]}");
                fi
            done
        elif [[ $item =~ ^[0-9]+$ ]]; then
            if [[ $item -ge 1 && $item -le ${#images_array[@]} ]]; then
                SELECTED_IMAGES+=("${images_array[$((item-1))]}");
            fi
        fi
    done
}

##############################################################################
# Tag Generation
##############################################################################

generate_tag() {
    local image=$1
    local config="${IMAGE_PATHS[$image]}/tag-config.yaml"
    
    local format=$(yq eval '.format' "$config" 2>/dev/null)
    if [[ -z "$format" ]]; then
        return
    fi
    
    local tag="$format"
    
    # Replace each {component} with its .version field from config
    while IFS= read -r line; do
        if [[ $line =~ \{([^}]+)\} ]]; then
            local component="${BASH_REMATCH[1]}"
            local version=$(yq eval ".components[] | select(.name == \"$component\") | .version" "$config" 2>/dev/null)
            if [[ -n "$version" && "$version" != "null" ]]; then
                tag="${tag//\{$component\}/$version}"
            fi
        fi
    done < <(echo "$format" | grep -o '{[^}]*}')
    
    echo "$tag"
}

build_and_push() {
    local image=$1
    local image_dir="${IMAGE_PATHS[$image]}"
    local config="$image_dir/tag-config.yaml"
    
    # Check if image requires latest tag
    local requires_latest=$(yq eval '.requiresIsLatest' "$config" 2>/dev/null)
    
    # Generate the tag
    local tag=$(generate_tag "$image")
    
    if [[ "$DRY_RUN" == true ]]; then
        if [[ -z "$AWS_ACCOUNT_ID" ]]; then
            log_warning "Would skip push - no AWS Account ID provided"
        else
            local latest_msg=""
            if [[ "$requires_latest" == "true" ]]; then
                latest_msg=" + tag as latest"
            fi
            log_warning "[DRY-RUN] Would: build image, login to ECR, push $tag$latest_msg"
        fi
        return
    fi
    
    log_info "Building and pushing $image..."
    
    if [[ -z "$AWS_ACCOUNT_ID" ]]; then
        log_warning "Skipping push - no AWS Account ID provided"
        return
    fi
    
    # Get commit hash
    local commit=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
    
    # Build image
    local ecr_url="${AWS_ACCOUNT_ID}.dkr.ecr.eu-west-2.amazonaws.com/onsdigital"
    local top_dir="${image%%/*}"
    local repo_name="dp-concourse-tools-${top_dir}"
    local image_uri="${ecr_url}/${repo_name}:${tag}"
    
    if ! (cd "$image_dir" && docker build --build-arg COMMIT="$commit" -t "$image_uri" .); then
        log_error "Failed to build $image"
        return 1
    fi
    
    # Login to ECR
    if ! aws ecr get-login-password --region eu-west-2 --profile "$AWS_PROFILE" | docker login --username AWS --password-stdin "$ecr_url"; then
        log_error "Failed to login to ECR"
        return 1
    fi
    
    # Push image
    if ! docker push "$image_uri"; then
        log_error "Failed to push $image"
        return 1
    fi
    
    # Push latest tag if required
    if [[ "$requires_latest" == "true" ]]; then
        local latest_uri="${ecr_url}/${repo_name}:latest"
        if ! docker tag "$image_uri" "$latest_uri"; then
            log_error "Failed to tag $image as latest"
            return 1
        fi
        if ! docker push "$latest_uri"; then
            log_error "Failed to push latest tag for $image"
            return 1
        fi
        log_success "Built and pushed $image with tag $tag (+ latest)"
    else
        log_success "Built and pushed $image with tag $tag"
    fi
}

confirm_update() {
    local image=$1
    
    echo ""
    log_info "Ready to update: $image"
    read -p "Continue? (y/n): " -r confirm
    
    if [[ "${confirm,,}" != "y" ]]; then
        log_warning "Skipping $image"
        return 1
    fi
    
    return 0
}

show_tags() {
    local image=$1
    local tag=$(generate_tag "$image")
    
    if [[ -n "$tag" ]]; then
        log_info "Generated tag for $image: $tag"
    fi
}

show_summary() {
    local total=$1
    local success=$2
    local failed=$3
    
    echo ""
    log_info "========== Update Summary =========="
    log_info "Total images: $total"
    log_success "Successful: $success"
    if [[ $failed -gt 0 ]]; then
        log_error "Failed: $failed"
    fi
    echo ""
}

##############################################################################
# Main Workflow
##############################################################################

main() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                echo "Usage: $0 [--dry-run]"
                exit 1
                ;;
        esac
    done
    
    if [[ "$DRY_RUN" == true ]]; then
        log_warning "Running in DRY-RUN mode - will show what would be built/pushed"
    fi
    
    check_dependencies
    discover_images
    show_menu
    
    echo ""
    read -p "Enter AWS Account ID (or leave blank to skip ECR push): " -r AWS_ACCOUNT_ID
    read -p "Enter AWS Profile (default: dp-ci, blank to keep): " -r profile_input
    [[ -n "$profile_input" ]] && AWS_PROFILE="$profile_input"
    
    local success=0
    local failed=0
    
    log_info "\n========== Starting Build & Push =========="
    
    for image in "${SELECTED_IMAGES[@]}"; do
        if confirm_update "$image"; then
            if build_and_push "$image"; then
                show_tags "$image"
                ((success++))
            else
                ((failed++))
            fi
        else
            ((failed++))
        fi
    done
    
    show_summary "${#SELECTED_IMAGES[@]}" "$success" "$failed"
}

# Run main function
main "$@"